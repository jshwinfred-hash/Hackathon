def connect():
    return sqlite3.connect(DB_PATH)


def setup_database():
    with connect() as con:

        con.execute("""
        CREATE TABLE IF NOT EXISTS settings (
            id INTEGER PRIMARY KEY CHECK(id=1),
            starting_balance REAL DEFAULT 0
        )
        """)

        con.execute("""
        INSERT OR IGNORE INTO settings(id, starting_balance)
        VALUES(1, 0)
        """)

        con.execute("""
        CREATE TABLE IF NOT EXISTS transactions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            kind TEXT,
            name TEXT,
            category TEXT,
            amount REAL,
            tx_date TEXT,
            note TEXT
        )
        """)

        con.execute("""
        CREATE TABLE IF NOT EXISTS goals (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT,
            target REAL,
            created TEXT
        )
        """)

        con.execute("""
        CREATE TABLE IF NOT EXISTS contributions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            goal_id INTEGER,
            amount REAL,
            saved_date TEXT
        )
        """)

        con.execute("""
        CREATE TABLE IF NOT EXISTS wishlist (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT,
            price REAL,
            category TEXT,
            priority TEXT,
            added TEXT
        )
        """)


setup_database()


def query_df(sql, params=()):
    with connect() as con:
        return pd.read_sql_query(sql, con, params=params)


def get_starting_balance():
    result = query_df(
        "SELECT starting_balance FROM settings WHERE id=1"
    )
    return float(result.iloc[0, 0])


def save_starting_balance(amount):
    with connect() as con:
        con.execute(
            "UPDATE settings SET starting_balance=? WHERE id=1",
            (float(amount),)
        )


def add_transaction(kind, name, category, amount, tx_date, note=""):
    with connect() as con:
        con.execute("""
        INSERT INTO transactions
        (kind, name, category, amount, tx_date, note)
        VALUES (?, ?, ?, ?, ?, ?)
        """, (
            kind, name, category, float(amount),
            str(tx_date), note
        ))


def get_goals():
    return query_df("""
        SELECT
            g.id,
            g.name,
            g.target,
            COALESCE(SUM(c.amount), 0) AS saved
        FROM goals g
        LEFT JOIN contributions c ON g.id = c.goal_id
        GROUP BY g.id
        ORDER BY g.id DESC
    """)


def get_totals():
    tx = query_df("""
        SELECT kind, SUM(amount) AS total
        FROM transactions
        GROUP BY kind
    """)

    income = 0
    expenses = 0

    if not tx.empty:
        for _, row in tx.iterrows():
            if row["kind"] == "Income":
                income = float(row["total"] or 0)
            elif row["kind"] == "Expense":
                expenses = float(row["total"] or 0)

    goals = get_goals()
    savings = float(goals["saved"].sum()) if not goals.empty else 0

    total_money = get_starting_balance() + income - expenses
    available = total_money - savings

    return income, expenses, savings, total_money, available


def money(amount):
    return f"${float(amount):,.2f}"


